config usque 'main'
	# 1 — запускать службу (после usque register)
	option enabled '0'
	# socks | http-proxy | nativetun
	option mode 'socks'
	# для socks / http-proxy
	option bind '127.0.0.1'
	option port '1080'
	option config '/etc/usque/config.json'
	# дополнительные аргументы командной строки usque
	option args ''
