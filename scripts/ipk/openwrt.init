#!/bin/sh /etc/rc.common
# usque (Cloudflare WARP / MASQUE) — procd-служба для OpenWrt.
# Настройки читаются из /etc/config/usque (секция main).

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/usque

start_service() {
	local enabled mode bind port cfg extra

	config_load usque
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0

	config_get mode  main mode   socks
	config_get bind  main bind   127.0.0.1
	config_get port  main port   1080
	config_get cfg   main config /etc/usque/config.json
	config_get extra main args   ""

	if [ ! -f "$cfg" ]; then
		logger -t usque "нет $cfg — сначала выполните: usque -c $cfg register"
		return 1
	fi

	procd_open_instance
	case "$mode" in
	socks|http-proxy)
		# shellcheck disable=SC2086
		procd_set_param command "$PROG" -c "$cfg" "$mode" -b "$bind" -p "$port" $extra
		;;
	nativetun)
		# shellcheck disable=SC2086
		procd_set_param command "$PROG" -c "$cfg" nativetun $extra
		;;
	*)
		logger -t usque "неизвестный режим '$mode' (socks | http-proxy | nativetun)"
		procd_close_instance
		return 1
		;;
	esac
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger usque
}
